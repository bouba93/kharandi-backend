# ══════════════════════════════════════════════════════════════════════════════
#  KHARANDI — .env de PRODUCTION (modèle)
#
#  Copier sur le VPS puis compléter :
#      cp .env.production.example .env && nano .env
#  Ou générer automatiquement les secrets :
#      bash deploy/make-env.sh
#
#  ⚠️ Ce fichier-modèle est versionné. Le .env réel ne l'est JAMAIS
#     (il est listé dans .gitignore) et ne doit jamais être copié dans le
#     frontend Vercel : il contient la License Key LengoPay.
#
#  Permissions attendues :  chmod 600 .env
# ══════════════════════════════════════════════════════════════════════════════

# ─── Django ───────────────────────────────────────────────────────────────────
DEBUG=False

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=À_GÉNÉRER

# Domaines et IP autorisés à atteindre l'API. PAS de « * » : Django refuserait
# tout contrôle d'en-tête Host (liens de réinitialisation falsifiables).
# localhost/127.0.0.1/api/nginx sont ajoutés automatiquement par settings.py
# pour les healthchecks internes.
ALLOWED_HOSTS=api.kharandi.gn,212.95.33.158

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Utilisé par docker-compose pour créer/ouvrir la base. Ne JAMAIS changer
# POSTGRES_USER ou POSTGRES_DB sur une installation existante : le volume
# postgres_data conserve les identifiants d'origine.
POSTGRES_DB=kharandi_db
POSTGRES_USER=kharandi_user
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=À_GÉNÉRER

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis n'expose aucun port hors du réseau Docker : pas de mot de passe requis.
REDIS_URL=redis://redis:6379/0

# ─── Frontend (Vercel) ────────────────────────────────────────────────────────
FRONTEND_URL=https://kharandi.gn

# Origines autorisées à appeler l'API depuis un navigateur. Sans « * » :
# CORS_ALLOW_CREDENTIALS étant activé, un joker serait une faille directe.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://kharandi.gn,https://www.kharandi.gn

# Nécessaire pour l'admin Django derrière HTTPS.
CSRF_TRUSTED_ORIGINS=https://api.kharandi.gn,https://kharandi.gn,https://www.kharandi.gn

# ─── HTTPS ────────────────────────────────────────────────────────────────────
# LAISSER À False au premier démarrage. « bash deploy/enable-ssl.sh
# api.kharandi.gn admin@kharandi.gn » le passera à True automatiquement après
# avoir obtenu le certificat.
# Le passer à True avant d'avoir un certificat rend l'admin Django inaccessible :
# les cookies de session seraient marqués « secure » sur une connexion en clair,
# donc jamais renvoyés par le navigateur.
ENABLE_HTTPS=False

# ─── LengoPay ─────────────────────────────────────────────────────────────────
# ID Site fourni par LengoPay (websiteid).
LENGOPAY_SITE_ID=VXQsfatrR3pVaSc8

# License Key — secret absolu. Jamais dans le frontend, jamais dans Git,
# jamais dans une variable Vercel.
LENGOPAY_LICENSE_KEY=À_REMPLIR

# Base publique de l'API. C'est elle qui construit l'URL de callback déclarée
# chez LengoPay. Valeur cible : https://api.kharandi.gn — deploy/enable-ssl.sh
# effectue la bascule http → https automatiquement.
# N'acceptez aucun paiement réel tant que cette valeur est en http:// : le
# jeton de callback circulerait en clair.
LENGOPAY_PUBLIC_BASE_URL=https://api.kharandi.gn

# Jeton d'URL du callback. LengoPay ne signe pas ses notifications : ce jeton
# est le SEUL élément qui authentifie un callback entrant. Long et aléatoire.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LENGOPAY_CALLBACK_TOKEN=À_GÉNÉRER

# Laisser VIDE : l'URL est construite automatiquement en
# https://api.kharandi.gn/api/v1/payments/webhook/<TOKEN>/
# C'est cette URL exacte qu'il faut déclarer dans le portail LengoPay.
# L'afficher avec : docker compose exec api python manage.py lengopay_doctor
LENGOPAY_CALLBACK_URL=

# Confirmation serveur OBLIGATOIRE : un callback « SUCCESS » ne valide un
# paiement que si l'API LengoPay le confirme. Ne fonctionne que parce que
# Celery Beat réconcilie les paiements toutes les 3 minutes.
LENGOPAY_REQUIRE_STATUS_CONFIRMATION=True

# Écart de montant toléré, en unités de devise (GNF).
LENGOPAY_AMOUNT_TOLERANCE=1

# Délai d'appel HTTP vers LengoPay, en secondes.
LENGOPAY_TIMEOUT=20

# Fréquence de réconciliation, en minutes. C'est le délai maximal pendant
# lequel un client ayant payé peut rester sans son abonnement.
LENGOPAY_RECONCILE_EVERY_MIN=3

# Signature HMAC : inutilisée (LengoPay ne signe pas). Laisser vide.
LENGOPAY_WEBHOOK_SECRET=

# ─── Divers ───────────────────────────────────────────────────────────────────
# Secret de l'endpoint manuel /api/v1/payments/run-cron/ (en-tête X-Cron-Secret).
# Optionnel : Celery Beat rend cet endpoint inutile, mais il sert au diagnostic.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
CRON_SECRET=À_GÉNÉRER

# ─── Limitation de débit et quota Karamo ──────────────────────────────────────
# Ces valeurs sont lues au DÉMARRAGE du conteneur : après modification,
# `docker compose up -d api` suffit — aucune reconstruction d'image nécessaire.
# Vérifier les valeurs réellement chargées :
#   docker compose exec api python manage.py karamo_doctor
RATE_LIMIT_ENABLED=True

# Limite générale de l'API, par utilisateur (adresse IP en repli).
RATE_LIMIT_PER_MIN=300

# Limite des endpoints Karamo. Une conversation en streaming consomme une
# requête par message envoyé.
RATE_LIMIT_AI_MIN=30

# Messages Karamo gratuits par jour et par utilisateur non abonné.
KARAMO_FREE_DAILY_LIMIT=50

CELERY_LOGLEVEL=info
CELERY_CONCURRENCY=2

# ─── Notifications SMS (Nimba SMS) — optionnel ────────────────────────────────
NIMBA_SMS_SERVICE_ID=
NIMBA_SMS_SECRET_TOKEN=
NIMBA_SMS_SENDER_NAME=Kharandi
