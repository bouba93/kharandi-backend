# ══════════════════════════════════════════════════════════════════════════════
# Kharandi Backend — VPS YIGUI (212.95.33.158)
# Copier en `.env` sur le serveur puis remplir les valeurs marquées « À REMPLIR ».
#   cp .env.yigui.example .env && nano .env
# ══════════════════════════════════════════════════════════════════════════════

# ─── Django ───────────────────────────────────────────────────────────────────
# Générer : python3 -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=À_REMPLIR_CLE_SECRETE_64_CARACTERES
DEBUG=False
# Hôtes publics du BACKEND uniquement. localhost / 127.0.0.1 / api / nginx
# sont ajoutés automatiquement par settings.py : inutile de les répéter.
# Ne PAS mettre "*" — Nginx filtre déjà les Host inconnus (444).
ALLOWED_HOSTS=212.95.33.158,api.kharandi.gn

# ─── Base de données PostgreSQL (conteneur `db`) ──────────────────────────────
POSTGRES_DB=kharandi_db
POSTGRES_USER=kharandi_user
POSTGRES_PASSWORD=À_REMPLIR_MOT_DE_PASSE_POSTGRES_FORT
# DATABASE_URL est injecté automatiquement par docker-compose. Ne pas modifier.

# ─── Redis / Celery (conteneur `redis`) ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS / CSRF — origines autorisées du frontend Kharandi ───────────────────
CORS_ALLOW_ALL_ORIGINS=False
# Origines du FRONTEND Vercel autorisées à appeler cette API.
CORS_ALLOWED_ORIGINS=https://kharandi.gn,https://www.kharandi.gn,http://localhost:5173
# Mettre True pour autoriser aussi les déploiements de prévisualisation Vercel
# (https://<projet>-<hash>.vercel.app).
VERCEL_PREVIEW_CORS=False
# Origines de confiance CSRF (admin Django, formulaires). Le schéma est requis.
CSRF_TRUSTED_ORIGINS=https://kharandi.gn,https://www.kharandi.gn,http://212.95.33.158
FRONTEND_URL=https://kharandi.gn

# Laisser False : Nginx transmet déjà le vrai Host. Ne passer à True que si un
# second proxy (Cloudflare, load balancer) est ajouté DEVANT Nginx.
USE_X_FORWARDED_HOST=False

# Passer à True uniquement après activation du SSL (deploy/enable-ssl.sh le fait
# automatiquement). Sinon les cookies sécurisés casseraient l'accès en HTTP.
ENABLE_HTTPS=False

# ─── SMS Nimba (OTP) ──────────────────────────────────────────────────────────
NIMBA_ACCOUNT_SID=À_REMPLIR
NIMBA_AUTH_TOKEN=À_REMPLIR
NIMBA_SENDER_NAME=Kharandi

# ─── Paiement LengoPay ────────────────────────────────────────────────────────
# Identifiants fournis par LengoPay (portail marchand).
LENGOPAY_SITE_ID=À_REMPLIR
LENGOPAY_LICENSE_KEY=À_REMPLIR
LENGOPAY_CURRENCY=GNF
LENGOPAY_COUNTRY=GN

# Racine de l'API. Sandbox : https://sandbox.lengopay.com/api/v1
LENGOPAY_BASE_URL=https://portal.lengopay.com/api/v1

# JETON DE CALLBACK — OBLIGATOIRE.
# LengoPay ne signe pas ses notifications : ce secret, placé dans l'URL de
# callback, est le seul élément qui authentifie l'appel. Sans lui, un tiers
# pourrait déclencher l'activation d'un abonnement non payé.
# Générer une valeur unique :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LENGOPAY_CALLBACK_TOKEN=À_GÉNÉRER

# Base publique du backend (sans slash final). L'URL de callback complète est
# construite automatiquement à partir de cette base et du jeton ci-dessus.
LENGOPAY_PUBLIC_BASE_URL=http://212.95.33.158

# Laisser VIDE pour la construction automatique. À ne renseigner que pour
# forcer une URL différente (elle doit alors contenir le jeton).
LENGOPAY_CALLBACK_URL=

# Endpoints (valeurs par défaut conformes à la documentation officielle).
# Ne surcharger qu'en cas d'évolution de l'API côté LengoPay.
#   Création : POST .../payments              body {websiteid, amount, ...}
#   Statut   : POST .../transaction/status    body {pay_id, websiteid}
# ATTENTION : l'ancienne valeur .../payments/{pay_id} n'existe pas dans l'API.
LENGOPAY_PAYMENT_URL=
LENGOPAY_STATUS_URL=

# Signature HMAC facultative. LengoPay ne signe pas ses callbacks : laisser
# vide. À ne remplir que si le fournisseur en propose un jour une.
LENGOPAY_WEBHOOK_SECRET=

# CONFIRMATION SERVEUR OBLIGATOIRE. True = un callback « SUCCESS » n'est
# appliqué que si l'API LengoPay le confirme (appel serveur-à-serveur).
# Une indisponibilité de l'API laisse alors le paiement en attente jusqu'au
# passage de la réconciliation — c'est pourquoi le service `beat` doit tourner.
LENGOPAY_REQUIRE_STATUS_CONFIRMATION=True

# Fréquence de la réconciliation automatique, en minutes. C'est le délai
# maximal pendant lequel un client ayant payé peut rester sans son abonnement
# si son callback a été perdu.
LENGOPAY_RECONCILE_EVERY_MIN=3

# Écart de montant toléré entre le callback et la transaction (même devise).
LENGOPAY_AMOUNT_TOLERANCE=1

# Délai maximal des appels HTTP vers LengoPay, en secondes.
LENGOPAY_TIMEOUT=20

# ─── IA (Karamo) ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=À_REMPLIR
GEMINI_API_KEY=
TAVILY_API_KEY=

# ─── Stockage médias Cloudinary (optionnel) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Compte super-administrateur créé au démarrage ────────────────────────────
ADMIN_PHONE=À_REMPLIR_NUMERO_ADMIN_FORMAT_+224XXXXXXXXX
ADMIN_PASSWORD=À_REMPLIR_MOT_DE_PASSE_ADMIN_FORT

# ─── Sécurité des tâches planifiées ───────────────────────────────────────────
# Générer : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=À_REMPLIR

# ─── Démarrage du conteneur (start.sh) ────────────────────────────────────────
# Tout est idempotent. Valeurs par défaut recommandées en production :
RUN_MIGRATIONS=1        # applique `migrate --noinput` (jamais destructif)
RUN_COLLECTSTATIC=1
RUN_SEED=1              # joué une seule fois (marqueur /app/media/.kharandi)
RUN_BAC_IMPORT=1        # idem
RUN_BAC_SCRAPER=0       # job long : à lancer manuellement si besoin
RUN_CELERY_IN_API=0     # Celery tourne dans le service `worker` dédié

# Réglages Gunicorn / Celery
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=4
DB_WAIT_TIMEOUT=90

# ─── Limitation de débit et quota Karamo ──────────────────────────────────────
# Ces valeurs sont lues au DÉMARRAGE du conteneur : après modification,
# `docker compose up -d api` suffit — aucune reconstruction d'image nécessaire.
# Vérifier les valeurs réellement chargées :
#   docker compose exec api python manage.py karamo_doctor
RATE_LIMIT_ENABLED=True

# Limite générale de l'API, par utilisateur (adresse IP en repli).
RATE_LIMIT_PER_MIN=300

# Limite des endpoints Karamo. Une conversation en streaming consomme une
# requête par message envoyé.
RATE_LIMIT_AI_MIN=30

# Messages Karamo gratuits par jour et par utilisateur non abonné.
KARAMO_FREE_DAILY_LIMIT=50
