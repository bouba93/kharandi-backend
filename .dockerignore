# Réduit le contexte de build et évite de copier le .env réel dans l'image.
.git
.gitignore
.env
.env.*
!.env.example
!.env.yigui.example
!.env.production.example
__pycache__/
*.py[cod]
venv/
.venv/
*.sqlite3
staticfiles/
media/
beat/
celerybeat-schedule*
celerybeat.pid
logs/
*.log
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
backups/
*.sql
*.sql.gz
*.dump
