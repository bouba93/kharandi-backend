+# ═══════════════════ 7 à 9. Comptes existants, liaison, doublons ══════════════
+class ComptesExistantsTests(BaseGoogleTests):
+
+    def setUp(self):
+        self.user = User.objects.create_user(phone="+224620111222", role="TUTOR")
+        self.user.set_password("motdepasse")
